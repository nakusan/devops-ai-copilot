# 复制为 deploy/.env 供 Compose 变量替换（勿提交真实密钥）。
# docker compose 会自动读取与 compose 文件同目录的 .env。

# 与 control-plane / ai-plane 必须一致
JWT_SECRET=dev-only-change-me-to-a-long-random-secret-key
SERVICE_TOKEN_SECRET=dev-only-service-token-secret-change-me

# Spring profile：json=结构化日志；本地调试可改空或 default
SPRING_PROFILES_ACTIVE=json

# LLM：默认 mock；智谱示例：
# LLM_MODE=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.7-flash
LLM_MODE=mock
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Embedding（硅基流动示例）：
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024
# EMBEDDING_MODEL_VERSION=bge-m3

# Phase 7 / P1：Python → Tempo OTLP（Compose 内默认 tempo；宿主机跑应用用 localhost）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces

# Phase 7 / P2：Java → Tempo OTLP
# TRACING_OTLP_ENDPOINT=http://tempo:4318/v1/traces
# TRACING_SAMPLE_RATE=1.0
