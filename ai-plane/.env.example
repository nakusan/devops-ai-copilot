# 复制为 .env 做本机覆盖。切勿提交真实密钥。
SERVICE_NAME=ai-plane
# 必须与 Java copilot.service-token.secret 一致
SERVICE_TOKEN_SECRET=dev-only-service-token-secret-change-me
# 入站：Java → Python
SERVICE_TOKEN_AUDIENCE=ai-plane
# 出站：Python → Java
SERVICE_TOKEN_OUTBOUND_AUDIENCE=control-plane
SERVICE_TOKEN_ISSUER=ai-plane

# LLM：mock（默认，无 Key 可用）| openai（OpenAI 兼容 API）
LLM_MODE=mock
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MOCK_DELAY_MS=30
LLM_MOCK_CHUNK_SIZE=2

# Embedding（W7 RAG 检索；无 Key 时用 hash 假向量降级）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1536
EMBEDDING_MODEL_VERSION=v1

# pgvector 只读连接（W7；本地可用业务账号，Compose 全栈用 copilot_ro）
# DATABASE_READONLY_URL=postgresql://copilot_ro:copilot_ro@localhost:5432/copilot
# Java Internal API（Python → Java 回调；本机默认 localhost）
# Compose 全栈内请用：http://control-plane:8080
JAVA_INTERNAL_BASE_URL=http://localhost:8080

# Kafka / MinIO（Phase 4 Worker 必需；HTTP 聊天可不配 Kafka）
# 本机进程：localhost:9092；Compose 内应用：kafka:29092
KAFKA_BOOTSTRAP=localhost:9092
# WORKER_ROLES=knowledge,analysis
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=devops-copilot
MINIO_SECURE=false

# REDIS_URL=redis://localhost:6379/0

# Observability（W10 / Phase 7）
OTEL_SERVICE_NAME=ai-plane
# Compose 内：http://tempo:4318/v1/traces ；本机直连 Tempo：http://localhost:4318/v1/traces
# 必须含 /v1/traces 路径（OTLP/HTTP exporter）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# SERVICE_VERSION=0.1.0
# DEPLOY_ENV=dev
# OTEL_SAMPLE_RATE=1.0

# Chat HTTP 后端：orchestrator（默认，LangGraph）| mock（Phase 2 回退）
CHAT_BACKEND=orchestrator

# MCP（W11）
MCP_ENABLED=true
MCP_DEFAULT_TIMEOUT_SECONDS=5
